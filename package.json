{
  "name": "@keshavsoft/npm-source-explorer",
  "version": "1.4.0",
  "description": "Download and clone all upstream Git repositories behind any npm package as sibling folders in your workspace.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./v4": "./src/v4/index.js",
    "./v3": "./src/v3/index.js"
  },
  "bin": {
    "npm-source-explorer": "cli/index.js"
  },
  "files": [
    "src/",
    "cli/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check cli/index.js && node --check src/index.js && node --check src/v4/index.js && node --check src/v3/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshavsoft/npm-source-explorer.git"
  },
  "homepage": "https://github.com/keshavsoft/npm-source-explorer#readme",
  "bugs": {
    "url": "https://github.com/keshavsoft/npm-source-explorer/issues"
  },
  "author": "KeshavSoft",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@npmcli/arborist": "^10.0.4"
  },
  "keywords": [
    "npm",
    "dependency-graph",
    "repository",
    "git",
    "source",
    "cli",
    "clone",
    "siblings"
  ],
  "license": "MIT"
}
